NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor — analítica, vault admin, facturas. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cifrado AES-GCM de contraseñas del vault /admin/proyectos (solo servidor).
# Si no se define, se deriva de SUPABASE_SERVICE_ROLE_KEY. Genera una clave larga aleatoria.
PROJECT_SECRETS_KEY=

# Firma HMAC de la cookie httpOnly atrix_admin_session (expira en 8h).
# Si no se define, se deriva de PROJECT_SECRETS_KEY o SUPABASE_SERVICE_ROLE_KEY;
# en producción sin ninguno de los tres el login admin queda deshabilitado.
# Genera una clave larga aleatoria (ej. openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# Opcional: hash de la contraseña admin si no usas la tabla admin_credentials
# (formato scrypt$... generado por hashPassword en src/lib/admin-server-auth.ts).
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD_CHANGED=true

NEXT_PUBLIC_SITE_URL=https://atrixnld.com
NEXT_PUBLIC_WHATSAPP=528677290445

# Google Search Console — meta tag de verificación (opcional)
# En Search Console → Configuración → Verificación de la propiedad → Etiqueta HTML
# Copia solo el valor del atributo content= (sin comillas)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — Measurement ID (opcional, ej. G-XXXXXXXXXX)
# Solo se carga si el visitante acepta cookies no esenciales.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# CallMeBot — avisos de formulario por WhatsApp (uso personal)
# 1) Agrega +34 684 783 347 a contactos
# 2) Envíale: I allow callmebot to send me messages
# 3) Copia el APIKEY que te responde el bot
CALLMEBOT_PHONE=5218677290445
CALLMEBOT_APIKEY=

# ---------------------------------------------------------------------------
# Marketing en redes y Campañas pagadas (Meta). Ponlas en Vercel → Production.
# Los tokens van como tipo "Secret" y NUNCA en el código ni en el chat.
# Sin ellas todo queda guardado como borrador y el panel dice qué falta.
# ---------------------------------------------------------------------------
# Publicaciones orgánicas (Admin → Marketing en redes)
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_TOKEN=
META_GRAPH_VERSION=v23.0

# Anuncios (Admin → Campañas pagadas). Cuenta publicitaria de ATRIX en MXN.
META_AD_ACCOUNT_ID=
META_ADS_TOKEN=
# Tope por campaña en MXN (opcional, 5000 por defecto)
AD_MAX_BUDGET_MXN=
# "true" solo si el WhatsApp Business está vinculado a la página de Facebook
META_WHATSAPP_LINKED=

# Pixel de Meta de ATRIX (no es secreto). Solo carga con "Aceptar" en el aviso de cookies.
META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Opcionales: token de la Conversions API (si no, usa META_ADS_TOKEN) y código de prueba
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Cron de publicaciones (/api/cron/social). Vercel lo manda solo como Bearer.
CRON_SECRET=

# Textos con IA (opcional). Sin clave se usan los textos de las plantillas.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_DAILY_CAP=200
