NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Solo servidor — analítica, vault admin, facturas, tarjeta. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cifrado AES-GCM de contraseñas del vault /admin/proyectos (solo servidor).
# Si no se define, se deriva de SUPABASE_SERVICE_ROLE_KEY. Genera una clave larga aleatoria.
PROJECT_SECRETS_KEY=

# Firma HMAC de la cookie httpOnly atrix_admin_session (expira en 8h).
# Si no se define, se deriva de PROJECT_SECRETS_KEY o SUPABASE_SERVICE_ROLE_KEY.
# Genera una clave larga aleatoria (ej. openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# Opcional: hash SHA-256 de la contraseña admin si no usas tabla admin_credentials.
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD_CHANGED=true

NEXT_PUBLIC_SITE_URL=https://atrixnld.com
NEXT_PUBLIC_WHATSAPP=528671793155

# Google Search Console — meta tag de verificación (opcional)
# En Search Console → Configuración → Verificación de la propiedad → Etiqueta HTML
# Copia solo el valor del atributo content= (sin comillas)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — Measurement ID (opcional, ej. G-XXXXXXXXXX)
# Solo se carga si el visitante acepta cookies no esenciales.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# CallMeBot — avisos de formulario por WhatsApp (uso personal)
# 1) Agrega +34 684 783 347 a contactos
# 2) Envíale: I allow callmebot to send me messages
# 3) Copia el APIKEY que te responde el bot
CALLMEBOT_PHONE=5218671793155
CALLMEBOT_APIKEY=
